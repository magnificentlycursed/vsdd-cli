#!/usr/bin/env bash
# Runs `mdatron verify` when any markdown / schema / pattern file is staged.
# Enable per-clone with:  git config core.hooksPath .githooks
set -euo pipefail

if ! command -v mdatron >/dev/null 2>&1; then
  # Fail-closed (operator ruling 2026-07-20, vsdd-cli #658): a missing
  # conformance checker blocks the commit rather than silently skipping —
  # a guarded no-op hides the absence until something depends on it.
  echo "pre-commit: mdatron not on PATH — commit blocked (fail-closed)" >&2
  echo "pre-commit: install with  cargo install mdatron --version 0.7.0 --locked" >&2
  echo "pre-commit: (bypass for a genuine emergency: git commit --no-verify — the deviation is yours to record)" >&2
  exit 2
fi

# Minimum-version sanity check (per crosslink #12 PE/F2). mdatron 0.7.0
# adoption (vsdd-cli#893, after the 0.6.0 adoption vsdd-cli#877): mdatron must
# be 0.7.x — envelope 3.1.0 (a MINOR: the `rule_dsl` family's own tri-state,
# `manifest.yaml` in the `inputs` lineage), the unverifiable-reference finding
# split out of the pipeline-failure code (E0081 vs E0080), `*` no longer
# crossing `/` in route and scope globs, the `every`/`order` section rules
# (E0123/E0124), and `init` refreshing its unedited templates. A 0.6.x binary
# emits the 3.0.0 envelope and fails the CI envelope assertion's exact-equality
# pin.
#
# Fail-closed on both branches (Solution Owner ruling (a), 2026-10-06,
# vsdd-cli#855 residual 2), like the absence branch above: a binary outside
# the window may parse this tree's configuration and judge it differently
# (the 0.7.0 glob change is the model), so a warning that proceeds would let
# an out-of-window verdict gate the commit. Grade: friction, not a block —
# `git commit --no-verify` remains the documented bypass, and the deviation
# is the committer's to record. CI pins the exact version and is the block.
MIN_VERSION="0.7.0"
mdatron_version=$(mdatron --version 2>/dev/null | awk '{print $2}' || true)
if [ -z "$mdatron_version" ]; then
  echo "pre-commit: could not determine the mdatron version (empty output) — commit blocked (fail-closed)" >&2
  echo "pre-commit:   reinstall with  cargo install mdatron --version 0.7.0 --locked --force" >&2
  echo "pre-commit: (bypass for a genuine emergency: git commit --no-verify — the deviation is yours to record)" >&2
  exit 2
elif ! printf '%s\n' "$mdatron_version" | grep -qE '^0\.7\.[0-9]+$'; then
  echo "pre-commit: mdatron ${mdatron_version} is outside the 0.7.x supported window — commit blocked (fail-closed)" >&2
  echo "pre-commit:   reinstall with  cargo install mdatron --version 0.7.0 --locked --force" >&2
  echo "pre-commit:   minimum required for vsdd-cli compatibility: ${MIN_VERSION}" >&2
  echo "pre-commit: (bypass for a genuine emergency: git commit --no-verify — the deviation is yours to record)" >&2
  exit 2
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -qE '(\.md$|^\.mdatron/|^vsdd-core/(schemas|patterns)/)'; then
  exit 0
fi

echo "pre-commit: running mdatron verify…" >&2
exec mdatron verify --project-root .
