#!/usr/bin/env bash
# Runs `mdatron verify` when any markdown / schema / pattern file is staged.
# Enable per-clone with:  git config core.hooksPath .githooks
set -euo pipefail

if ! command -v mdatron >/dev/null 2>&1; then
  # Fail-closed (operator ruling 2026-07-20, vsdd-cli #658): a missing
  # conformance checker blocks the commit rather than silently skipping —
  # a guarded no-op hides the absence until something depends on it.
  echo "pre-commit: mdatron not on PATH — commit blocked (fail-closed)" >&2
  echo "pre-commit: install with  cargo install --path ../mdatron --locked" >&2
  echo "pre-commit: (bypass for a genuine emergency: git commit --no-verify — the deviation is yours to record)" >&2
  exit 2
fi

# Minimum-version sanity check (per crosslink #12 PE/F2). mdatron 0.6.0
# adoption (vsdd-cli#877): mdatron must be 0.6.x — envelope 3.0.0 (a MAJOR:
# required envelope_schema + inputs, per-finding fingerprints, nine families),
# load-time refusal of non-2020-12 schema dialects (E0040), strict pattern
# files, array-only `in`/`not_in`, and the loud-absence section/marker codes
# (E0122/E0114). A 0.5.x binary emits the retired 2.1.0 envelope and fails the
# CI envelope assertion, so warn early.
MIN_VERSION="0.6.0"
mdatron_version=$(mdatron --version 2>/dev/null | awk '{print $2}' || true)
if [ -z "$mdatron_version" ]; then
  echo "pre-commit: could not determine mdatron version (got empty output) — proceeding" >&2
elif ! printf '%s\n' "$mdatron_version" | grep -qE '^0\.6\.[0-9]+'; then
  echo "pre-commit: mdatron version ${mdatron_version} is outside the 0.6.x supported window" >&2
  echo "pre-commit:   reinstall with  cargo install mdatron --version 0.6.0 --locked --force" >&2
  echo "pre-commit:   minimum required for vsdd-cli compatibility: ${MIN_VERSION}" >&2
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -qE '(\.md$|^\.mdatron/|^vsdd-core/(schemas|patterns)/)'; then
  exit 0
fi

echo "pre-commit: running mdatron verify…" >&2
exec mdatron verify --project-root .
