# Working artifacts from pre-design synthesis (2026-05; operator-private)
archive/

# === Crosslink managed (do not edit between markers) ===
# .crosslink/ — machine-local state (never commit)
.crosslink/issues.db
.crosslink/issues.db-wal
.crosslink/issues.db-shm
.crosslink/agent.json
.crosslink/session.json
.crosslink/daemon.pid
.crosslink/daemon.log
.crosslink/last_test_run
.crosslink/.active-issue
.crosslink/keys/
.crosslink/.hub-cache/
.crosslink/.knowledge-cache/
.crosslink/.cache/
.crosslink/init-manifest.json
.crosslink/init-manifest.json.tmp
.crosslink/hook-config.local.json
.crosslink/integrations/
.crosslink/rules.local/

# .crosslink/ — DO track these (project-level policy):
#   .crosslink/hook-config.json   — shared team configuration
#   .crosslink/rules/             — project coding standards
#   .crosslink/.gitignore         — inner gitignore for agent files

# .claude/ — crosslink-managed content is auto-generated (not project source);
# vsdd-cli's OWN vsdd-prefixed artifacts ARE source-of-truth and tracked
# (they're what `vsdd init` deploys to adopting projects).
# Deliberate divergence from the canonical block, restored after the
# 2026-07-20 init --update clobber (operator ruling on vsdd-cli #597).
.claude/hooks/*
!.claude/hooks/vsdd-*
!.claude/hooks/vsdd-*.py
.claude/commands/*
!.claude/commands/vsdd-*
!.claude/commands/vsdd-*.md
.claude/mcp/*
!.claude/mcp/vsdd-*
!.claude/mcp/vsdd-*.json

# .claude/ — DO track these (if manually configured):
#   .claude/settings.json         — Claude Code project settings
#   .claude/settings.local.json is per-developer, ignore separately if needed
# === End crosslink managed ===

# Rust build artifacts
/target/

# Chassis machine-local state crosslink 0.8.0 writes but its managed block
# does not yet ignore (upstream finding filed on this tracker; these entries
# move into the managed block when upstream absorbs them)
.crosslink/.last-hydrated-ref
.crosslink/.promoted-uuids
.crosslink/promotion-log.json

# crosslink 0.9 migration arrivals: crosslink-deployed skills; the pre-v3 backup store
.claude/skills/
.crosslink/pre-v3-backup-*.db
